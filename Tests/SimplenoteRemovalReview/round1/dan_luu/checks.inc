- (void)nv_runTests {
    @try {
        const NSUInteger count = 1024;
        NSString *external = [NSString stringWithUTF8String:getenv("NV_DAN_DIRECTORY")];
        NSString *fixture = [external stringByAppendingPathComponent:@"large-legacy.notation"];
        BOOL oldApp = NSClassFromString(@"SimplenoteSession") != Nil;
        BOOL generate = getenv("NV_DAN_GENERATE") != NULL;
        NSString *directory = [TestDirectory stringByAppendingPathComponent:@"MeasuredLibrary"];
        Check([[NSFileManager defaultManager] createDirectoryAtPath:directory withIntermediateDirectories:NO attributes:nil error:NULL], @"create a separate disposable measured library");
        NSString *database = [directory stringByAppendingPathComponent:@"Notes & Settings"];
        if (generate) {
            Check(oldApp, @"fixture is generated by the pre-removal app");
            NSMutableArray *notes = [NSMutableArray arrayWithCapacity:count];
            NotationPrefs *prefs = [[[NotationPrefs alloc] init] autorelease];
            // Disabled synthetic account: no remote session, credentials, or keychain operation.
            [prefs setValue:[NSMutableDictionary dictionaryWithDictionary:@{@"Simplenote":
                [NSMutableDictionary dictionaryWithDictionary:@{@"enabled": @NO, @"username": @"benchmark@example.invalid"}]}]
                forKey:@"syncServiceAccounts"];
            for (NSUInteger index = 0; index < count; index++) {
                NoteObject *note = [[[NoteObject alloc] initWithNoteBody:[[[NSAttributedString alloc] initWithString:DanBody(index, NO)] autorelease]
                    title:DanTitle(index) delegate:nil format:SingleDatabaseFormat labels:@"local, café"] autorelease];
                CFUUIDBytes uuid = DanUUID(index); *[note uniqueNoteIDBytes] = uuid;
                [note setValue:[DanTitle(index) stringByAppendingString:@".txt"] forKey:@"filename"];
                [note incrementLSN];
                [note setValue:[NSMutableDictionary dictionaryWithDictionary:@{@"Simplenote":
                    [NSMutableDictionary dictionaryWithDictionary:@{@"key": [NSString stringWithFormat:@"remote-%lu", (unsigned long)index],
                        @"version": @(index + 1), @"dirty": @YES, @"historical": [DanBody(index + count, NO) substringToIndex:512]}]}]
                    forKey:@"syncServicesMD"];
                [prefs setSourceMetadata:@{@"syntax": index % 16 ? @"plain" : @"markdown"} forNoteUUID:[NSString uuidStringWithBytes:uuid]];
                [notes addObject:note];
            }
            NSData *data = [FrozenNotation frozenDataWithExistingNotes:notes deletedNotes:[NSMutableSet set] prefs:prefs];
            Check([data writeToFile:database atomically:YES], @"write the large pre-removal fixture");
            // Normalize disk identity and archive defaults through the real baseline controller.
            NotationController *normalizer = DanOpen(directory);
            Check([normalizer flushAllNoteChanges], @"baseline controller stores normalized library");
            [normalizer closeAllResources]; [normalizer release];
            data = [NSData dataWithContentsOfFile:database];
            Check([data writeToFile:fixture atomically:YES], @"save generated fixture for paired runs");
            NSLog(@"DAN_GENERATED notes=%lu sourceCharacters=%lu fixtureBytes=%lu", (unsigned long)count,
                (unsigned long)([DanBody(0, NO) length] * count), (unsigned long)[data length]);
            _exit(0);
        }
        Check([[NSData dataWithContentsOfFile:fixture] writeToFile:database atomically:YES], @"copy the identical baseline archive into the measured directory");
        DecodedLive = CFSetCreateMutable(kCFAllocatorDefault, 0, NULL);
        DanSwap([NotationController class], @selector(storeDataAtomicallyInNotesDirectory:withName:destinationRef:verifyWithSelector:verificationDelegate:), @selector(nv_dan_store:withName:destinationRef:verifyWithSelector:verificationDelegate:));
        DanSwap([WALStorageController class], @selector(writeNoteObject:), @selector(nv_dan_write:));
        DanSwap([NoteObject class], @selector(initWithCoder:), @selector(nv_dan_decode:));
        DanSwap([NoteObject class], @selector(encodeWithCoder:), @selector(nv_dan_encode:));
        DanSwap([NoteObject class], @selector(dealloc), @selector(nv_dan_dealloc));
        CountOperations = YES;
        NSUInteger firstSteadySize = 0, editedSize = 0, totalWrites = 0, totalJournalWrites = 0;
        // Eight close/reopen cycles. Cycles 0-3 are unchanged. Cycle 4 edits 64 notes.
        // Cycles 5-7 prove edited data persists. The existing foreground preference
        // setter dirties each reopened library, so compare its one-snapshot behavior.
        for (NSUInteger cycle = 0; cycle < 8; cycle++) {
            NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
            SnapshotWrites = SnapshotBytes = JournalWrites = EncodedNotes = DecodedNotes = 0;
            NSData *before = [NSData dataWithContentsOfFile:database];
            NotationController *library = DanOpen(directory);
            Check([[library allNotes] count] == count, @"all synthetic notes reopen");
            BOOL valid = YES;
            for (NoteObject *note in [library allNotes]) {
                NSString *title = [note valueForKey:@"titleString"];
                NSUInteger index = [[title substringFromIndex:10] integerValue];
                CFUUIDBytes uuid = DanUUID(index);
                valid = valid && index < count && [title isEqualToString:DanTitle(index)] &&
                    [[[note contentString] string] isEqualToString:DanBody(index, cycle > 4 && index % 16 == 0)] &&
                    !memcmp([note uniqueNoteIDBytes], &uuid, sizeof(uuid)) &&
                    [[note valueForKey:@"labelString"] isEqualToString:@"local, café"] &&
                    [[note sourceSyntaxIdentifier] isEqualToString:index % 16 ? @"plain" : @"markdown"];
                if (cycle == 4 && index % 16 == 0)
                    [note setContentString:[[[NSAttributedString alloc] initWithString:DanBody(index, YES)] autorelease]];
            }
            Check(valid, @"every source, UUID, title, tag, and syntax survives the repeated reopen");
            Check([library flushAllNoteChanges], @"real local snapshot save succeeds");
            NSUInteger writesAfterFirstFlush = SnapshotWrites;
            for (NSUInteger retry = 0; retry < 5; retry++) Check([library flushAllNoteChanges], @"unchanged repeated flush succeeds");
            Check(SnapshotWrites == writesAfterFirstFlush, @"five unchanged flushes do not write another snapshot");
            [library closeAllResources]; [library release];
            NSData *after = [NSData dataWithContentsOfFile:database];
            NSUInteger size = [after length];
            BOOL sameBytes = [before isEqual:after];
            if (cycle == 0) firstSteadySize = size;
            if (cycle == 4) editedSize = size;
            if (cycle > 0 && cycle < 4) Check(size == firstSteadySize && sameBytes && SnapshotWrites == 1 && JournalWrites == 0, @"unchanged reopened library has identical bytes, one existing preference snapshot, and zero journal writes");
            if (cycle > 4) Check(size == editedSize && sameBytes && SnapshotWrites == 1 && JournalWrites == 0, @"edited library remains byte-stable with one existing preference snapshot per subsequent reopen");
            if (cycle == 4) Check(SnapshotWrites == 1 && JournalWrites == count / 16, @"64 source changes produce one snapshot and exactly 64 successful journal records");
            totalWrites += SnapshotWrites; totalJournalWrites += JournalWrites;
            NSUInteger decoded = DecodedNotes, encoded = EncodedNotes, writes = SnapshotWrites, bytes = SnapshotBytes, journal = JournalWrites;
            [pool drain];
            // Record retained decoded-note counts for a paired comparison. The baseline
            // verifier retains its decoded array; zero would assert an existing leak away.
            NSLog(@"DAN_CYCLE app=%@ cycle=%lu snapshotWrites=%lu snapshotBytes=%lu journalWrites=%lu encodedNotes=%lu decodedNotes=%lu liveDecoded=%ld databaseBytes=%lu unchanged=%d",
                oldApp ? @"baseline" : @"current", (unsigned long)cycle, (unsigned long)writes, (unsigned long)bytes,
                (unsigned long)journal, (unsigned long)encoded, (unsigned long)decoded, CFSetGetCount(DecodedLive), (unsigned long)size, sameBytes);
        }
        NSLog(@"DAN_RESULT app=%@ checks=%lu cycles=8 notes=%lu totalSnapshotWrites=%lu totalJournalWrites=%lu firstSteadyBytes=%lu editedBytes=%lu",
            oldApp ? @"baseline" : @"current", (unsigned long)Checks, (unsigned long)count, (unsigned long)totalWrites,
            (unsigned long)totalJournalWrites, (unsigned long)firstSteadySize, (unsigned long)editedSize);
        _exit(0);
    } @catch (NSException *exception) { NSLog(@"FAIL %@", exception); _exit(1); }
}
