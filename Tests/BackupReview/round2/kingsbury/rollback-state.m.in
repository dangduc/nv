@interface NotationController : NSObject {
@public
    BOOL openingRestoredLibrary, backupRestorePrepared, capturingBackup, notesChanged, backupJournalSyncFailed;
    FakePrefs *notationPrefs;
    WALStorageController *walWriter;
    NSData *backupCheckpointData;
    NSError *backupCheckpointError;
    NSMutableArray *allNotes;
    NSMutableSet *unwrittenNotes;
    NSTimer *changeWritingTimer;
    OSStatus lastWriteError;
    FSRef noteDatabaseRef, noteDirectoryRef;
}
- (NSString *)createCachesFolder;
- (NSURL *)notesDirectoryURL;
- (BOOL)initializeJournaling;
- (BOOL)resumeAfterBackupRestoreFailureWithError:(NSError **)error;
- (BOOL)prepareForBackupRestoreWithError:(NSError **)error;
- (NSDictionary *)backupSnapshotWithError:(NSError **)error;
- (void)processRecoveredNotes:(NSDictionary *)notes;
- (BOOL)flushAllNoteChanges;
- (void)refilterNotes;
- (NSInteger)currentNoteStorageFormat;
- (void)databaseSettingsChangedFromOldFormat:(NSInteger)format;
- (void)synchronizeNoteChanges:(NSTimer *)timer;
- (void)scheduleWriteForNote:(NoteObject *)note;
- (void)scheduleUpdateListForAttribute:(NSString *)attribute;
- (void)purgeOldPerDiskInfoFromNotes;
- (void)stopFileNotifications;
- (OSStatus)storeDataAtomicallyInNotesDirectory:(NSData *)data withName:(NSString *)name destinationRef:(FSRef *)ref verifyWithSelector:(SEL)selector verificationDelegate:(id)delegate;
- (id)initWithRestoredDirectoryRef:(FSRef *)ref unlockedPrefs:(id)prefs error:(OSStatus *)error;
@end
@implementation NotationController
- (id)init {
    if ((self = [super init])) {
        notationPrefs = [FakePrefs new];
        allNotes = [[NSMutableArray alloc] initWithObjects:[[[NoteObject alloc] init] autorelease], nil];
        unwrittenNotes = [NSMutableSet new];
        notesChanged = YES;
    }
    return self;
}
- (NSString *)createCachesFolder { return fixtureDirectory; }
- (NSURL *)notesDirectoryURL { return sourceDirectory; }
- (void)processRecoveredNotes:(NSDictionary *)notes { Check(NO, @"restore never recovers the competing journal"); }
- (void)refilterNotes {}
- (NSInteger)currentNoteStorageFormat { return [notationPrefs notesStorageFormat]; }
- (void)databaseSettingsChangedFromOldFormat:(NSInteger)format { restarts++; }
- (void)scheduleUpdateListForAttribute:(NSString *)attribute {}
- (void)purgeOldPerDiskInfoFromNotes {}
- (void)stopFileNotifications {}
- (OSStatus)storeDataAtomicallyInNotesDirectory:(NSData *)data withName:(NSString *)name destinationRef:(FSRef *)ref verifyWithSelector:(SEL)selector verificationDelegate:(id)delegate {
    checkpointWrites++;
    return [data writeToURL:[sourceDirectory URLByAppendingPathComponent:name] atomically:YES] ? noErr : -1;
}
- (id)initWithRestoredDirectoryRef:(FSRef *)ref unlockedPrefs:(id)prefs error:(OSStatus *)error {
    self = [self init];
    replacementAttempts++;
    if (introduceCollision) Check([Bytes(@"competing library journal") writeToFile:JournalPath() atomically:NO], @"create competing journal in prepared gap");
    if (strcmp(exitMode, "initialization") == 0) {
        [self release];
        [NSException raise:@"FixtureInitialization" format:@"fixture-note-secret: replacement initialization raised"];
    }
    openingRestoredLibrary = YES;
    if (![self initializeJournaling]) { *error = -1; [self release]; return nil; }
    return self;
}
// PRODUCTION_INITIALIZATION
// PRODUCTION_FLUSH
// PRODUCTION_CAPTURE
// PRODUCTION_PREPARE
// PRODUCTION_RESUME
// PRODUCTION_AUTOSAVE
// PRODUCTION_SCHEDULE
- (void)dealloc {
    [NSObject cancelPreviousPerformRequestsWithTarget:self];
    [changeWritingTimer invalidate]; [changeWritingTimer release];
    [notationPrefs release]; [walWriter release]; [backupCheckpointData release]; [backupCheckpointError release];
    [allNotes release]; [unwrittenNotes release]; [super dealloc];
}
@end

// Browser and editing-session collaborators are deliberately inert. The exact
// application method determines commit calls and restoration guard changes.
@interface AppController : NSObject
- (void)finishEditing;
- (void)application:(NSApplication *)application openFiles:(NSArray *)files;
- (void)handleGetURLEvent:(NSAppleEventDescriptor *)event withReplyEvent:(NSAppleEventDescriptor *)reply;
- (void)createFromSelection:(NSPasteboard *)pboard userData:(NSString *)userData error:(NSString **)error;
- (void)applicationWillTerminate:(NSNotification *)notification;
- (NSUInteger)fixtureMutation;
@end
@implementation AppController
- (void)finishEditing {}
- (void)application:(NSApplication *)application openFiles:(NSArray *)files { externalEvents++; }
- (void)handleGetURLEvent:(NSAppleEventDescriptor *)event withReplyEvent:(NSAppleEventDescriptor *)reply { externalEvents++; }
- (void)createFromSelection:(NSPasteboard *)pboard userData:(NSString *)userData error:(NSString **)error { externalEvents++; }
- (void)applicationWillTerminate:(NSNotification *)notification { ReviewTerminationCallback(); }
- (NSUInteger)fixtureMutation { forwardedCalls++; return 91; }
@end
@interface NVNoteEditingSession : NSObject
- (void)commitPendingTextChanges;
- (void)close;
@end
@implementation NVNoteEditingSession
- (void)commitPendingTextChanges {}
- (void)close {}
@end
