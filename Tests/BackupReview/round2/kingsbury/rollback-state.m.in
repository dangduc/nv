+ (NSData *)frozenDataWithExistingNotes:(NSArray *)notes prefs:(FakePrefs *)prefs;
@end
@implementation FrozenNotation
+ (NSData *)frozenDataWithExistingNotes:(NSArray *)notes prefs:(FakePrefs *)prefs { return Bytes(((NoteObject *)[notes objectAtIndex:0])->body); }
@end
